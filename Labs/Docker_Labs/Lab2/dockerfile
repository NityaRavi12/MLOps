# ---------- Stage 1: Build and Train the Model ----------
FROM python:3.9 AS model_training

# Set working directory
WORKDIR /app

# Copy training source and dependencies
COPY src/model_training.py /app/
COPY requirements.txt /app/

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Train the model (saves to /app/models/my_model.keras and /app/models/scaler.pkl)
RUN python model_training.py


# ---------- Stage 2: Serve Predictions ----------
FROM python:3.9 AS serving

# Set working directory
WORKDIR /app

# Ensure models folder exists
RUN mkdir -p /app/models

# Copy both the trained model and scaler from the training stage
COPY --from=model_training /app/models/my_model.keras /app/models/my_model.keras
COPY --from=model_training /app/models/scaler.pkl /app/models/scaler.pkl

# Copy application source files
COPY src/main.py /app/
COPY requirements.txt /app/
COPY src/templates /app/templates
COPY src/statics /app/statics

# Expose Flask port (your app runs on port 4000)
EXPOSE 4000

# Define environment variable (fixed format)
ENV NAME=World

# Install dependencies for serving stage
RUN pip install --no-cache-dir -r requirements.txt

# Start the Flask app
CMD ["python", "main.py"]
